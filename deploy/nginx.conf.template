# Frontend server: the built client, plus a same-origin proxy to the API.
# ${API_UPSTREAM} and ${PORT} are filled in at container start (nginx envsubst templates).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

log_format genui '$time_iso8601 INFO  web     request method=$request_method path=$uri '
                 'status=$status ms=$request_time bytes=$body_bytes_sent upstream_ms=$upstream_response_time';

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  access_log /dev/stdout genui;
  error_log /dev/stderr warn;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Health of this container (the API has its own /api/health).
  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # Builds stream over SSE for up to a few minutes: no buffering, long timeouts.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    client_max_body_size 2m;
  }

  # Realtime voice (WebSocket).
  location /voice {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /docs {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
  }

  location = /openapi.json {
    proxy_pass http://${API_UPSTREAM};
  }

  # Hashed build assets can be cached forever.
  location /assets/ {
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
