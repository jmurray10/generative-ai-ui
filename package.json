{
  "name": "genui-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A public playground showcasing generative UI — describe an interface and watch a working, interactive UI build itself.",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server/index.ts",
    "preview": "vite preview",
    "e2e": "node scripts/e2e.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.39.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expr-eval": "^2.0.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "playwright": "^1.61.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
