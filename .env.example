# GenUI Playground configuration
# Copy to .env. The app runs fully WITHOUT any key (offline stub generator +
# pre-baked gallery). Add a key only to enable live LLM generation.

PORT=8080
NODE_ENV=development

# Generation provider: "stub" (default, offline) or "gemini"
GENERATOR=stub

# Gemini (only needed when GENERATOR=gemini). Either var name works.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
