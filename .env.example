# GenUI Playground configuration
# Copy to .env. With no key the server starts in stub mode and shows a
# "connect a model" notice. There are no pre-baked UIs.

PORT=8080
NODE_ENV=development

# Generation provider: "grok" (default), "gemini" (opt-in), or "stub" (offline notice)
GENERATOR=grok

# Grok text generation (Responses API). Required for GENERATOR=grok.
XAI_API_KEY=
# Optional regional or compatible base. Default https://api.x.ai/v1
# XAI_BASE_URL=https://us.api.x.ai/v1
# Flagship text model as of Oct 2026. Override to pin another model id.
GROK_MODEL=grok-4.7
# grok-4.7 defaults to high reasoning. low keeps this playground responsive.
GROK_REASONING_EFFORT=low

# Voice provider: unset follows the key (Grok when XAI_API_KEY is set),
# "grok", "gemini", or "off".
# VOICE_PROVIDER=grok
# Speech-to-speech model. grok-voice-latest is the stable alias.
# The Oct 10, 2026 docs route that alias to grok-voice-think-fast-2.0.
GROK_VOICE_MODEL=grok-voice-latest
# Built-in voice id (eve, ara, …). See GET /v1/tts/voices.
GROK_VOICE=eve
# Realtime reasoning is "none" or "high". none is the snappy default.
GROK_VOICE_REASONING=none

# Gemini remains available behind the switch. Not used unless selected.
# GENERATOR=gemini
# VOICE_PROVIDER=gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# LIVE_API_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# LIVE_API_VOICE=Kore

# Optional hardening
# CORS_ORIGIN=http://localhost:5173
# RATE_LIMIT_PER_MIN=30
# MAX_PROMPT_CHARS=4000
# STREAM_STAGGER_MS=110

# Jev toolbox router (decides lane, needed pieces, whether to ask first, or hold).
# auto = TypeSafe Jev when TYPESAFE_API_KEY is set, else a Grok judge answering the same questions.
TOOLBOX_DECIDER=auto
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# TYPESAFE_TIMEOUT_MS=4000
# The Grok judge is a classifier; a fast non-reasoning model keeps routing ~2s.
# Chat confirmations reuse it unless CHAT_CONFIRM_MODEL is set.
JEV_JUDGE_MODEL=grok-4.20-0309-non-reasoning

# Logs (docker compose logs -f api). debug adds streamed parts and voice transcripts; json for log shippers.
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# Behind a proxy: which hops to trust for the client IP (rate limits). Default: loopback + private networks.
# TRUST_PROXY=
# Compose: host port for the web service.
# WEB_PORT=8080

# Size cap for a spec sent back for refine/chat (it goes into the model prompt).
# MAX_SPEC_CHARS=200000
# Voice sessions per client IP (each opens a paid realtime session) and new sessions per minute.
# VOICE_MAX_SESSIONS=2
# VOICE_OPENS_PER_MIN=10
